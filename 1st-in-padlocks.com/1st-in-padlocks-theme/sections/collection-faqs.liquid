{% comment %} SS Changes Collection FAQs: same markup, styling and schema as the product FAQs (main-product.liquid), read from collection.metafields.custom.ss_faqs {% endcomment %}
{%- assign faqs = collection.metafields.custom.ss_faqs.value -%}

{%- if faqs != blank -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .accordion {
      color: inherit;
      padding: 20px;
    }

    #shopify-section-{{ section.id }} .accordion .accordion-content-container {
      font-size: 0.9rem;
      padding: 10px;
    }

    #shopify-section-{{ section.id }} .accordion .accordion-content-container .question {
      position: relative;
      padding-bottom: 10px;
      border-bottom: solid 1px #000;
      font-size: 1.1rem;
      cursor: pointer;
    }

    #shopify-section-{{ section.id }} .accordion .accordion-content-container .question::after {
      content: '+';
      position: absolute;
      right: 10px;
    }

    #shopify-section-{{ section.id }} .accordion-content-container .answer {
      margin-top: 10px;
      line-height: 1.3;
      height: 0;
      overflow: hidden;
      transition: .5s;
    }

    #shopify-section-{{ section.id }} .accordion .accordion-content-container.active .answer {
      height: auto;
    }

    #shopify-section-{{ section.id }} .accordion .accordion-content-container.active .question::after {
      content: '-';
      font-weight: 700;
    }
  {%- endstyle -%}

  <section class="section">
    <div class="container">
      <div class="card">
        <div class="accordion article-template-content rte">
          {%- if section.settings.title != blank -%}
            <h2 class="accordion-title">{{ section.settings.title | escape }}</h2>
          {%- endif -%}

          {%- for faq in faqs -%}
            <div class="accordion-content-container">
              <div class="question">{{ faq.question | escape }}</div>
              <div class="answer">{{ faq.answer | metafield_tag | strip_html }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll('#shopify-section-{{ section.id }} .accordion-content-container').forEach(function (item) {
      item.addEventListener('click', function () {
        this.classList.toggle('active');
      });
    });
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for faq in faqs -%}
          {
            "@type": "Question",
            "name": {{ faq.question | escape | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ faq.answer | metafield_tag | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Collection FAQs",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "FAQs"
    },
    {
      "type": "paragraph",
      "content": "FAQs are linked per collection from the backend (collection metafield custom.ss_faqs)."
    }
  ]
}
{% endschema %}
